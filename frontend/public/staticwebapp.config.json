{
  "routes": [
    {
      "route": "/api/*",
      "rewrite": "/api/*"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/static/*",
      "/*.css",
      "/*.js",
      "/*.ico",
      "/*.json",
      "/manifest.json",
      "/robots.txt",
      "/favicon.ico"
    ]
  },
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad",
      "statusCode": 302
    }
  },
  "forwardingGateway": {
    "requiredHeaders": {
      "X-Azure-FDID": ""
    }
  }
}
